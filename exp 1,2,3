<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Navigation -->
    <header>
        <h2>My Portfolio</h2>
        <nav>
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#skills">Skills</a>
            <a href="#contact">Contact</a>
        </nav>
        <button id="themeBtn">Dark Mode</button>
    </header>
    <!-- Home -->
    <section id="home">
        <h1>Hello, I'm <span>Your Name</span></h1>
        <p>Computer Science Student & Web Developer</p>
        <button onclick="showMessage()">Click Me</button>
        <p id="message"></p>
    </section>
    <!-- About -->
    <section id="about">
        <h2>About Me</h2>
        <p>
            I am a Computer Science student interested in
            web development and programming.
        </p>
    </section>
    <!-- Skills -->
    <section id="skills">
        <h2>My Skills</h2>
        <div class="skills-container">
            <div class="card">HTML</div>
            <div class="card">CSS</div>
            <div class="card">JavaScript</div>
            <div class="card">React</div>
        </div>
    </section>
    <!-- Contact Form -->
    <section id="contact">
        <h2>Contact Me</h2>
        <form id="contactForm">
            <input type="text" id="name"
                   placeholder="Enter your name">
            <input type="text" id="email"
                   placeholder="Enter your email">
            <input type="text" id="phone"
                   placeholder="Enter phone number">
            <textarea id="msg"
                      placeholder="Enter your message"></textarea>
            <button type="submit">Submit</button>
            <p id="error"></p>
            <p id="success"></p>
        </form>
    </section>
    <footer>
        <p>© 2026 My Portfolio</p>
    </footer>
    <script src="script.js"></script>
</body>
</html>
---------------------------------------------------------------------------------------------------------------------------------------------------------------
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
body {
    font-family: Arial, sans-serif;
    background: #f4f4f4;
    color: #333;
}
header {
    background: #222;
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
}
nav a {
    color: white;
    text-decoration: none;
    margin: 10px;
}
button {
    padding: 10px 20px;
    background: #007bff;
    color: white;
    border: none;
    cursor: pointer;
    border-radius: 5px;
}
section {
    padding: 50px 20px;
    text-align: center;
}
#home {
    background: #dceeff;
    padding: 100px 20px;
}
#home span {
    color: #007bff;
}
.skills-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 20px;
}
.card {
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 2px 8px #ccc;
}
form {
    max-width: 400px;
    margin: auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
}
input, textarea {
    padding: 12px;
    border: 1px solid #aaa;
    border-radius: 5px;
}
textarea {
    height: 100px;
}
#error {
    color: red;
}
#success {
    color: green;
}
footer {
    background: #222;
    color: white;
    text-align: center;
    padding: 20px;
}
/* Dark Mode */
.dark {
    background: #222;
    color: white;
}
.dark .card {
    background: #444;
    color: white;
}
/* Responsive Design */
@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }
    .skills-container {
        grid-template-columns: repeat(2, 1fr);
    }
    nav a {
        margin: 5px;
    }
}
