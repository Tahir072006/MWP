<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Personal Portfolio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        html {
            scroll-behavior: smooth;
        }
        body {
            font-family: Arial, sans-serif;
        }
        .gradient {
            background: linear-gradient(135deg, #2563eb, #9333ea);
        }
    </style>
</head>
<body class="bg-gray-950 text-white">
    <!-- HEADER -->
    <header class="bg-gray-900 shadow-lg sticky top-0 z-50">
        <nav class="container mx-auto px-6 py-4 flex justify-between items-center">
            <h2 class="text-2xl font-bold text-blue-400">
                My Portfolio
            </h2>
            <div class="hidden md:flex gap-6">
                <a href="#home" class="hover:text-blue-400">Home</a>
                <a href="#about" class="hover:text-blue-400">About</a>
                <a href="#skills" class="hover:text-blue-400">Skills</a>
                <a href="#projects" class="hover:text-blue-400">Projects</a>
                <a href="#contact" class="hover:text-blue-400">Contact</a>
            </div>
            <a href="#contact"
               class="bg-blue-600 px-4 py-2 rounded-lg hover:bg-blue-700">
                Hire Me
            </a>
        </nav>
    </header>
    <!-- HERO SECTION -->
    <section id="home"
        class="container mx-auto px-6 py-20 md:py-32 grid md:grid-cols-2 gap-10 items-center">
        <div>
            <p class="text-blue-400 text-lg mb-3">Hello, Welcome!</p>
            <h1 class="text-4xl md:text-6xl font-bold mb-5">
                I'm <span class="text-blue-400">Tahir Ahamed</span>
            </h1>
            <h2 class="text-2xl font-semibold mb-5">
                Computer Science Student & Developer
            </h2>
            <p class="text-gray-400 mb-8 leading-relaxed">
                I am a passionate developer interested in web development,
                programming and DevOps. I love creating innovative projects
                and learning new technologies.
            </p>
            <a href="#projects"
               class="gradient px-6 py-3 rounded-lg inline-block hover:opacity-80">
                View My Projects
            </a>
        </div>
        <div class="flex justify-center">
            <div class="w-64 h-64 md:w-80 md:h-80 rounded-full gradient
                        flex items-center justify-center text-8xl font-bold">
                TA
            </div>
        </div>
    </section>
    <!-- ABOUT SECTION -->
    <section id="about" class="bg-gray-900 py-20 px-6">
        <div class="container mx-auto text-center max-w-3xl">
            <h2 class="text-3xl font-bold mb-8">
                About <span class="text-blue-400">Me</span>
            </h2>
            <p class="text-gray-400 leading-8">
                I am a third-year Computer Science Engineering student
                with an interest in software development and DevOps.
                I have knowledge of HTML, CSS, JavaScript, React,
                Python and C++. My goal is to become a skilled software
                engineer by building real-world projects and improving
                my technical knowledge.
            </p>
        </div>
    </section>
    <!-- SKILLS SECTION -->
    <section id="skills" class="container mx-auto py-20 px-6">
        <h2 class="text-3xl font-bold text-center mb-12">
            My <span class="text-blue-400">Skills</span>
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <div class="bg-gray-900 p-6 rounded-xl text-center hover:bg-blue-900">
                <h3 class="text-xl font-semibold">HTML5</h3>
            </div>
            <div class="bg-gray-900 p-6 rounded-xl text-center hover:bg-blue-900">
                <h3 class="text-xl font-semibold">CSS3</h3>
            </div>
            <div class="bg-gray-900 p-6 rounded-xl text-center hover:bg-blue-900">
                <h3 class="text-xl font-semibold">JavaScript</h3>
            </div>
            <div class="bg-gray-900 p-6 rounded-xl text-center hover:bg-blue-900">
                <h3 class="text-xl font-semibold">React</h3>
            </div>
            <div class="bg-gray-900 p-6 rounded-xl text-center hover:bg-blue-900">
                <h3 class="text-xl font-semibold">Python</h3>
            </div>
            <div class="bg-gray-900 p-6 rounded-xl text-center hover:bg-blue-900">
                <h3 class="text-xl font-semibold">C++</h3>
            </div>
            <div class="bg-gray-900 p-6 rounded-xl text-center hover:bg-blue-900">
                <h3 class="text-xl font-semibold">Docker</h3>
            </div>
            <div class="bg-gray-900 p-6 rounded-xl text-center hover:bg-blue-900">
                <h3 class="text-xl font-semibold">Git & GitHub</h3>
            </div>
        </div>
    </section>
    <!-- PROJECTS SECTION -->
    <section id="projects" class="bg-gray-900 py-20 px-6">
        <div class="container mx-auto">
            <h2 class="text-3xl font-bold text-center mb-12">
                My <span class="text-blue-400">Projects</span>
            </h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="bg-gray-800 rounded-xl p-6 hover:scale-105 transition">
                    <h3 class="text-xl font-bold mb-4 text-blue-400">
                        Travel Management System
                    </h3>
                    <p class="text-gray-400 mb-5">
                        A web application for booking flights and hotels
                        using React, Node.js and MongoDB.
                    </p>
                    <a href="#" class="text-blue-400 hover:underline">
                        View Project →
                    </a>
                </div>
                <div class="bg-gray-800 rounded-xl p-6 hover:scale-105 transition">
                    <h3 class="text-xl font-bold mb-4 text-blue-400">
                        Lost and Found Portal
                    </h3>
                    <p class="text-gray-400 mb-5">
                        A MERN stack application that helps users report
                        and find lost items.
                    </p>
                    <a href="#" class="text-blue-400 hover:underline">
                        View Project →
                    </a>
                </div>
                <div class="bg-gray-800 rounded-xl p-6 hover:scale-105 transition">
                    <h3 class="text-xl font-bold mb-4 text-blue-400">
                        Portfolio Website
                    </h3>
                    <p class="text-gray-400 mb-5">
                        A responsive personal portfolio website built
                        using HTML, CSS and Tailwind CSS.
                    </p>
                    <a href="#" class="text-blue-400 hover:underline">
                        View Project →
                    </a>
                </div>
            </div>
        </div>
    </section>
    <!-- CONTACT SECTION -->
    <section id="contact" class="container mx-auto py-20 px-6">
        <h2 class="text-3xl font-bold text-center mb-10">
            Contact <span class="text-blue-400">Me</span>
        </h2>
        <form class="max-w-xl mx-auto bg-gray-900 p-8 rounded-xl"
              onsubmit="sendMessage(event)">
            <input type="text"
                   id="name"
                   placeholder="Your Name"
                   required
                   class="w-full p-3 mb-5 rounded-lg bg-gray-800 outline-none">
            <input type="email"
                   id="email"
                   placeholder="Your Email"
                   required
                   class="w-full p-3 mb-5 rounded-lg bg-gray-800 outline-none">
            <textarea id="message"
                      rows="5"
                      placeholder="Your Message"
                      required
                      class="w-full p-3 mb-5 rounded-lg bg-gray-800 outline-none"></textarea>
            <button type="submit"
                    class="gradient w-full py-3 rounded-lg font-bold hover:opacity-80">
                Send Message
            </button>
        </form>
    </section>
    <!-- FOOTER -->
    <footer class="bg-gray-900 text-center py-6">
        <p class="text-gray-400">
            © 2026 My Portfolio. All Rights Reserved.
        </p>
        <p class="mt-2 text-blue-400">
            Designed using HTML, CSS and Tailwind CSS
        </p>
    </footer>
    <!-- JAVASCRIPT -->
    <script>
        function sendMessage(event) {
            event.preventDefault();
            let name = document.getElementById("name").value;
            alert("Thank you " + name + "! Your message has been submitted.");
            document.querySelector("form").reset();
        }
    </script>
</body>
</html>
