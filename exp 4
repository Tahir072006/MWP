
import React from "react";
import {
  BrowserRouter,
  Routes,
  Route,
  Link
} from "react-router-dom";

// Home Component
function Home() {
  return (
    <div>
      <h2>Home Page</h2>
      <p>Welcome to the React Single Page Application!</p>
    </div>
  );
}

// About Component
function About() {
  return (
    <div>
      <h2>About Page</h2>
      <p>This application is developed using React Router.</p>
    </div>
  );
}

// Contact Component
function Contact() {
  return (
    <div>
      <h2>Contact Page</h2>
      <p>Email: example@gmail.com</p>
    </div>
  );
}

// Main App Component
function App() {
  return (
    <BrowserRouter>
      <div style={{ textAlign: "center" }}>

        <h1>React Single Page Application</h1>

        <nav>
          <Link to="/">Home</Link> {" | "}
          <Link to="/about">About</Link> {" | "}
          <Link to="/contact">Contact</Link>
        </nav>

        <hr />

        <Routes>
          <Route path="/" element={<Home />} />
          <Route path="/about" element={<About />} />
          <Route path="/contact" element={<Contact />} />
        </Routes>

      </div>
    </BrowserRouter>
  );
}

export default App;
